# Copy to .env and fill in. Never commit .env.

# LLM provider: "gemini" or "fake" (tests). "ollama" is optional and untested.
LLM_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Free-tier pacing: minimum seconds between Gemini requests.
GEMINI_MIN_INTERVAL_SECONDS=6
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_OUTPUT_TOKENS=16384
# Optional: minimal | low | medium | high (unset = model default)
# GEMINI_THINKING_LEVEL=low
# Retries after 429 / 503 / timeouts
LLM_TRANSIENT_RETRIES=3

# Storage
DATABASE_URL=sqlite:///./data/app.sqlite3
UPLOAD_DIR=./uploads

# Upload limits
MAX_UPLOAD_MB=10
MAX_PAGES=20

# Refuse uploads of frozen test-set PDFs (by SHA-256). Keep false; only the
# Phase 7 evaluation sets it to true.
ALLOW_TEST_SET_UPLOADS=false
